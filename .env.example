# Copy this file to .env for local development. .env is never committed.

# Postgres from docker-compose.yml, published on host port 5433.
DATABASE_URL=postgresql+psycopg://drivetruagent:drivetruagent@localhost:5433/drivetruagent

# One of: local, test, ci
ENVIRONMENT=local

LOG_LEVEL=INFO

# How long stock stays held for a session with no activity, in seconds.
RESERVATION_TTL_SECONDS=600

# Which model the agent uses:
#   openai  needs OPENAI_API_KEY
#   gemini  needs GEMINI_API_KEY; Google's API has a free tier
#   demo    a fixed scripted conversation that needs no key
AGENT_MODEL=openai
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-luna
# How hard the model reasons before answering: none, low, medium or high.
# "low" keeps turns quick; "none" is faster per call but jumps ahead.
OPENAI_REASONING_EFFORT=low
# Voice, through OpenAI Realtime. Needs OPENAI_API_KEY whichever model answers
# typed messages. Audio is billed by OpenAI per minute of speech, both ways.
VOICE_MODEL=gpt-realtime-2.1-mini
VOICE_NAME=marin
VOICE_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# A free key comes from Google AI Studio. On the free tier, requests are
# rate-limited and Google may use what is sent to improve its products.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash-lite

# Sales tax as a fraction of the subtotal (Ontario HST).
TAX_RATE=0.13

# Session timers, in seconds. After SILENCE_NUDGE_SECONDS of silence the
# customer is asked if they are still there; SILENCE_CLOSE_SECONDS later the
# session is closed. A session that has run SESSION_MAX_SECONDS is handed to
# a person. Raise these, or use the Pause button, when presenting.
SILENCE_NUDGE_SECONDS=20
SILENCE_CLOSE_SECONDS=20
SESSION_MAX_SECONDS=180
# How often the background task checks the timers. 0 turns it off.
TIMEKEEPER_INTERVAL_SECONDS=1

# Where the restaurant is. "Today's special" means today there.
RESTAURANT_TIMEZONE=America/Toronto

# How long the day's specials are served from memory, in seconds. 0 turns
# the cache off.
SPECIALS_CACHE_TTL_SECONDS=60

# Guardrails. Insults and attempts to get round the agent's rules are blocked
# with a fixed sentence; at GUARDRAIL_ABUSE_STRIKES the session is ended.
# Questions about anything but ordering are answered by the agent, and at
# GUARDRAIL_CONFUSION_STRIKES the customer is handed to a person. With the
# classifier off, only the built-in rules apply (no extra model call).
GUARDRAIL_ABUSE_STRIKES=3
GUARDRAIL_CONFUSION_STRIKES=3
GUARDRAIL_CLASSIFIER=true
# true: classify before the model is asked, so a blocked message never reaches
# it. false: both at once, about 1.5 s quicker per turn; a blocked message's
# answer is cancelled and never used.
GUARDRAIL_CHECK_FIRST=false

# Knowledge search. With OPENAI_API_KEY, questions and documents are embedded
# with EMBEDDING_MODEL; without one, with a local hashing embedder. Run
# `make ingest` after changing anything in knowledge/.
EMBEDDING_MODEL=text-embedding-3-small
# The score a passage needs to count as evidence. Leave unset for each
# embedder's measured default (0.35 for OpenAI, 0.15 for hashing).
# KNOWLEDGE_MIN_SCORE=
KNOWLEDGE_RESULTS=3

# Tracing to Arize Phoenix (`make phoenix`, then open http://localhost:6006).
# Leave unset to turn tracing off.
# TRACING_ENDPOINT=http://localhost:6006/v1/traces
TRACING_PROJECT=drivetruagent
